# Copy this file to .env and update with your actual values
# Never commit the .env file to version control

# Application Configuration
PORT=9090

# Security - Replace with your actual secret key
# Generate a secure key: openssl rand -base64 32
DEFAULT_KEY=sk-your-secret-key-here

# Debug and Features
DEBUG_MODE=true
DASHBOARD_ENABLED=true
DEFAULT_STREAM=true

# Language Configuration (default: en-US)
# Controls Accept-Language headers, date/time formatting, and user language
# Examples: en-US, zh-CN, fr-FR, de-DE, ja-JP, etc.
DEFAULT_LANGUAGE=en-US

# Authentication Options (choose one)

# Option 1: JWT-Based (RECOMMENDED - Unlimited like Conduit!)
# Get from browser: chat.z.ai → DevTools → Console → localStorage.getItem("token")
# ZAI_JWT_TOKEN=eyJhbGciOiJFUzI1NiIsInR5cCI6IkpXVCJ9...

# Option 2: Session Cookie (Alternative)
# Get from browser: chat.z.ai → DevTools → Application → Cookies → __Secure-next-auth.session-token
# ZAI_SESSION_TOKEN=your-session-token-here

# Option 3: API-Based (Token quota limits)
# To get your token: Log into https://chat.z.ai, open DevTools Console (F12), and run: localStorage.getItem("token")
# ZAI_TOKEN=your-token-from-chat-z-ai

# For multiple tokens (automatic rotation), use comma-separated values:
# ZAI_TOKENS=token1,token2,token3

# Option 4: Anonymous (Free but limited responses)
# Leave all above commented out for anonymous mode

# Upstream and Model Defaults
# DEFAULT_MODEL=GLM-5.3-Flash
# UPSTREAM_URL=https://chat.z.ai/api/v2/chat/completions

# Optional: Custom signing secret if modified upstream
# ZAI_SIGNING_SECRET=your-custom-signing-secret
