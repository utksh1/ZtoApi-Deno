{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.9"
  },
  "tasks": {
    "start": "deno run -A --env src/server/router.ts",
    "dev": "deno run -A --env --watch src/server/router.ts",
    "test": "deno test -A tests/",
    "test:quick": "deno test -A tests/unit_test.ts",
    "test:unit": "deno test tests/ --ignore=tests/integration_test.ts --allow-net --allow-env --allow-read",
    "test:integration": "deno test -A tests/integration_test.ts",
    "check": "deno check src/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  }
}
